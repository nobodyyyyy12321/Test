    "ollama": {
      "npm": "@ai-sdk/openai-compatible", // 調用相容模式
      "options": {
        "baseURL": "http://localhost:11434/v1" // 指向你本機的小章魚
      },
      "models": {
        "qwen2.5-coder:14b": {
          "name": "Qwen 2.5 Coder 14B"
        }
      }
    }
  }
}